// Gooo is the authority. Go implements only the declared parse/lower,
// generate, execute, and verify operations.
contract "gooo-proof-preserving-ir-optimizer/v1" {
  authority "metacode"
  grammar "expr-v1" "records-v1" "quoted-values-v1"
  version "1"
  language "go"
  precedence "REFUTED" "UNKNOWN" "CLOSED"
  unknown_fields "stage" "step" "reason" "unknown_class" "next_operation" "blocked_by"
  denominator "proof-preserving-ir-optimizer-v1" count "8"
  normalization comments "ignored" whitespace "collapsed" string_literals "preserved" operand_order "preserved"
  type "Int" kind "value"
  type "Bool" kind "predicate"
  type "Expr" kind "typed-effectful-ir"
  effect "PURE" kind "no-observable-effect"
  effect "IO" kind "ordered-observable-effect"
  effect "CAPABILITY" kind "authority-sensitive-effect"
  effect "NONDETERMINISTIC" kind "replay-sensitive-effect"
  capability "NONE" kind "no-capability"
  capability "OUTPUT" kind "output-capability"
  capability "AUTHORITY" kind "authority-capability"
  forbidden_effect "IO" when "discarded-by-rewrite"
  forbidden_effect "CAPABILITY" when "discarded-by-rewrite"
  forbidden_effect "NONDETERMINISTIC" when "discarded-by-rewrite"
  origin_map "source-origin" "derived-origin" preservation "all-source-anchors"
  rewrite "constant-fold" rule "fold-pure-int-and-bool" requires "PURE" preserves "type,effect,capability,terminal_reason,ordered_effect_trace,provenance_anchors"
  rewrite "dead-branch" rule "remove-constant-condition-only-when-discarded-branch-is-effect-free" requires "PURE" preserves "type,effect,capability,terminal_reason,ordered_effect_trace,provenance_anchors"
  rewrite "deterministic-cse" rule "reuse-first-left-to-right-pure-repeated-subexpression" requires "PURE" preserves "type,effect,capability,terminal_reason,ordered_effect_trace,provenance_anchors"
  obligation "typed-ir" stage "IR" step "check-type-effect-capability" proof "typed-ir-preserved" missing "IR_PROOF_MISSING"
  obligation "rewrite-rule" stage "REWRITE" step "check-declared-rule" proof "declared-rule-applied" missing "REWRITE_PROOF_MISSING"
  obligation "forbidden-effect" stage "REWRITE" step "check-discarded-effects" proof "forbidden-effects-not-discarded" missing "EFFECT_PROOF_MISSING"
  obligation "origin-map" stage "ORIGIN" step "check-all-source-anchors" proof "origin-anchors-preserved" missing "ORIGIN_PROOF_MISSING"
  obligation "terminal-reason" stage "EXECUTE" step "compare-terminal-reason" proof "terminal-reason-preserved" missing "TERMINAL_REASON_PROOF_MISSING"
  obligation "effect-trace" stage "EXECUTE" step "compare-ordered-effect-trace" proof "ordered-effect-trace-preserved" missing "EFFECT_TRACE_PROOF_MISSING"
  obligation "cost-witness" stage "COST" step "compare-exact-before-after" proof "exact-cost-pair-present" missing "COST_WITNESS_MISSING"
  cost_observation vector "binary_bytes,generated_bytes,wall_ms,peak_rss_kib" pair "same-scenario-source-contract-toolchain-runner" policy "exact-before-after-per-closed-case"
  authority_rule repository_writes "0" output_scope "CALLER_OWNED_TEMP_OUTPUT_ONLY" automatic_commit "0" automatic_push "0" automatic_merge "0" automatic_release "0"
  program "constant-fold" expr "add(const(2),mul(const(3),const(4)))" type "Int" effect "PURE" capability "NONE" result "14" reason "RETURN" origin "source.constant-fold"
  program "dead-branch" expr "if(const(false),add(const(100),const(1)),add(const(4),const(5)))" type "Int" effect "PURE" capability "NONE" result "9" reason "RETURN" origin "source.dead-branch"
  program "deterministic-cse" expr "add(mul(add(const(11),mul(const(12),const(13))),sub(mul(const(14),const(15)),const(16))),mul(add(const(11),mul(const(12),const(13))),sub(mul(const(14),const(15)),const(16))))" type "Int" effect "PURE" capability "NONE" result "64796" reason "RETURN" origin "source.deterministic-cse"
  program "effectful-branch" expr "if(const(false),const(9),effect(print,const(7)))" type "Int" effect "IO" capability "OUTPUT" result "7" reason "RETURN_AFTER_EFFECT" origin "source.effectful-branch"
  scenario "operator-constant-fold" expected "CLOSED" source "operator-constant-fold" operator "constant-fold" program "constant-fold" variant "operator" replay "false"
  scenario "operator-dead-branch" expected "CLOSED" source "operator-dead-branch" operator "dead-branch" program "dead-branch" variant "operator" replay "false"
  scenario "operator-deterministic-cse" expected "CLOSED" source "operator-deterministic-cse" operator "deterministic-cse" program "deterministic-cse" variant "operator" replay "false"
  scenario "comment-only" expected "CLOSED" source "comment-only" operator "constant-fold" program "constant-fold" variant "comment-only" replay "false"
  scenario "effectful-branch-removal" expected "REFUTED" source "effectful-branch-removal" operator "dead-branch" program "effectful-branch" variant "forbidden-effect" replay "false"
  scenario "origin-loss" expected "REFUTED" source "origin-loss" operator "constant-fold" program "constant-fold" variant "origin-loss" replay "false"
  scenario "missing-cost-witness" expected "UNKNOWN" source "missing-cost-witness" operator "constant-fold" program "constant-fold" variant "missing-cost" replay "false"
  scenario "replay" expected "CLOSED" source "replay" operator "deterministic-cse" program "deterministic-cse" variant "replay" replay "true"
}
